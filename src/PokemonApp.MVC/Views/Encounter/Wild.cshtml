@model PokemonApp.MVC.Models.Pokemon

@{
    ViewData["Title"] = "Rencontre Sauvage";
}

<div class="text-center mb-4">
    <h1 class="display-4">
        <i class="bi bi-exclamation-diamond-fill text-warning"></i>
        Un @Model.Name sauvage apparaît !
    </h1>
</div>

<div class="row">
    <div class="col-md-6 offset-md-3">
        <div class="card border-warning shadow-lg">
            <div class="card-body text-center">
                <div class="pokeball-large"></div>

                <img src="@Model.ImageURL" alt="@Model.Name" style="width: 200px; height: 200px; margin: 20px 0;">

                <h2 class="mb-3">@Model.Name</h2>

                <div class="mb-3">
                    <span class="type-badge type-@Model.Type.ToString().ToLower()" style="font-size: 1.1rem;">@Model.Type</span>
                </div>

                <div class="stats-section">
                    <div class="stat-item">
                        <span class="stat-label"><i class="bi bi-heart-fill text-danger"></i> Points de Vie</span>
                        <span class="stat-value">@Model.HealthPoints</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-label"><i class="bi bi-shield-fill text-primary"></i> Défense</span>
                        <span class="stat-value">@Model.DefensePoints</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-label"><i class="bi bi-star-fill text-warning"></i> Rareté</span>
                        <span class="stat-value">@((Model.RarityPercentage * 100).ToString("F0"))%</span>
                    </div>
                </div>

                <div class="mt-3">
                    <strong>Attaques:</strong>
                    <div class="mt-2">
                        @foreach (var attack in Model.Attacks)
                        {
                            <span class="badge bg-info me-2">@attack.Name (@attack.Points pts)</span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="card mt-4">
            <div class="card-header">
                <h4 class="mb-0"><i class="bi bi-cursor-fill"></i> Action</h4>
            </div>
            <div class="card-body">
                <form asp-action="Capture" method="post">
                    <input type="hidden" name="pokemonId" value="@Model.Id">

                    <div class="mb-3">
                        <label for="trainerId" class="form-label">
                            <strong><i class="bi bi-person-badge"></i> Dresseur</strong>
                        </label>
                        <select class="form-select" id="trainerId" name="trainerId" required>
                            <option value="" selected disabled>-- Sélectionnez un dresseur --</option>
                            @if (ViewBag.Trainers != null)
                            {
                                @foreach (var trainer in (SelectList)ViewBag.Trainers!)
                                {
                                    <option value="@trainer.Value">@trainer.Text</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label for="nickname" class="form-label">
                            <strong><i class="bi bi-tag"></i> Surnom (optionnel)</strong>
                        </label>
                        <input type="text" class="form-control" id="nickname" name="nickname" maxlength="50" placeholder="Donnez un surnom à votre Pokémon">
                    </div>

                    <div class="mb-4">
                        <label for="ballType" class="form-label">
                            <strong><i class="bi bi-circle"></i> Choisissez votre Poké Ball</strong>
                        </label>
                        <select class="form-select form-select-lg" id="ballType" name="ballType" required>
                            <option value="" selected disabled>-- Sélectionnez une balle --</option>
                            <option value="1">🔴 Poké Ball (Taux de base)</option>
                            <option value="2">🔵 Super Ball (Taux x1.5)</option>
                            <option value="3">🟣 Master Ball (Capture garantie)</option>
                        </select>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-success btn-lg">
                            <i class="bi bi-bullseye"></i> Lancer la balle !
                        </button>
                        <a asp-controller="Trainer" asp-action="Index" class="btn btn-danger btn-lg">
                            <i class="bi bi-dash-circle"></i> Fuir
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        @if (TempData["ErrorMessage"] != null)
        {
            <text>
            toastr.error('@TempData["ErrorMessage"]', 'Échec');
            </text>
        }
    </script>
}
