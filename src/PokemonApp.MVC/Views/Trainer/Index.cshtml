@model IEnumerable<PokemonApp.MVC.Models.Trainer>

@{
    ViewData["Title"] = "Liste des Dresseurs";
}

<h1><i class="bi bi-people-fill"></i> Liste des Dresseurs</h1>

<div class="mb-4">
    <a asp-action="Create" class="btn btn-success btn-lg">
        <i class="bi bi-plus-circle"></i> Nouveau dresseur
    </a>
</div>

<div class="table-responsive">
    <table class="table table-hover">
        <thead>
            <tr>
                <th>Nom</th>
                <th>Ville</th>
                <th>Badges</th>
                <th>Nb de Pokémon</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var trainer in Model)
            {
                <tr>
                    <td><strong>@trainer.Name</strong></td>
                    <td>@trainer.Town</td>
                    <td><span class="badge bg-warning text-dark">@trainer.BadgeCount</span></td>
                    <td><span class="badge bg-primary">@trainer.Team.Count</span></td>
                    <td>
                        <a asp-action="Details" asp-route-id="@trainer.Id" class="btn btn-primary btn-sm">
                            <i class="bi bi-eye"></i> Détails
                        </a>
                        <a asp-action="Edit" asp-route-id="@trainer.Id" class="btn btn-warning btn-sm">
                            <i class="bi bi-pencil"></i> Modifier
                        </a>
                        <a asp-action="Delete" asp-route-id="@trainer.Id" class="btn btn-danger btn-sm">
                            <i class="bi bi-trash"></i> Supprimer
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        @if (TempData["SuccessMessage"] != null)
        {
            <text>
            toastr.success('@TempData["SuccessMessage"]', 'Succès');
            </text>
        }
    </script>
}
